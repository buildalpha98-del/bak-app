# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (AI program generation)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend (email)
RESEND_API_KEY=your-resend-api-key

# Square (online invoice payments — optional)
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=

# ------------------------------------------------------------
# URLs
# ------------------------------------------------------------
# Both of these are NEXT_PUBLIC_* — they are inlined at BUILD time, not
# read at runtime. Changing either one requires a REDEPLOY to take
# effect; setting it in the Vercel dashboard alone does nothing.

# The APP origin. Every staff magic link, password reset, cron and
# invoice PDF links back to this. Leave unset locally (falls back to
# VERCEL_URL, then http://localhost:3000). Production pins it to
# https://buildalphakids.app.
NEXT_PUBLIC_SITE_URL=

# The PUBLIC MARKETING origin — leave BLANK until the DNS cutover.
#
# buildalphakids.com.au still serves WordPress until DNS moves, so this
# is the switch that arms the new origin. Setting it too early is the
# failure mode worth understanding:
#
#   UNSET (now)  → getMarketingUrl() falls back to getBaseUrl(), so
#                  parent invites, booking emails, referral share links
#                  and embed snippets all resolve to buildalphakids.app
#                  and keep working exactly as they do today.
#   SET (cutover)→ every one of those moves to the .com.au origin at
#                  once. This is step 8 of the cutover runbook in
#                  docs/superpowers/plans/2026-07-15-marketing-site.md.
#
# Two hard prerequisites, both of which fail SILENTLY if ignored:
#   1. The .com.au callback URLs must already be on the Supabase redirect
#      allowlist (runbook step 4). Supabase substitutes its project Site
#      URL for any emailRedirectTo that is not allowlisted rather than
#      erroring, so a parent magic link would just quietly go elsewhere.
#   2. DNS must ALREADY be cut over (runbook step 7). Set this while
#      .com.au still serves WordPress and every parent link names a host
#      that cannot answer. DNS-then-env has no broken window; the reverse
#      does — see the trace table at runbook step 7.
#
# NOTE: SEO surfaces (canonical tags, sitemap, robots, JSON-LD) do NOT
# use the fallback — they call getCanonicalSiteUrl(), which names
# .com.au whether or not this is set, so an un-flipped deploy can never
# advertise .app URLs to Google. See lib/utils/base-url.ts.
NEXT_PUBLIC_MARKETING_URL=
